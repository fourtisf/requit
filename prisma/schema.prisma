// Requit — data model.
//
// Sections 1 and 2 below map 1:1 onto HANDOFF.md §3. Do not "tidy" them: the
// unique constraints are load-bearing (they are the dedupe and anti-multi-account
// guards, not hints). Section 3 holds the models Auth.js requires; it is additive.
//
// Section 4 holds fields for features requested after the handoff was written
// (referral, notification preferences). They are NOT in §3 — see the note there.
//
// DEVIATIONS FROM §3 — every one, listed. No column in §3 was changed or dropped.
//   1. Wallet.withdrawals / Withdrawal.wallet — §3 gives Withdrawal a `walletId`
//      but no relation. Prisma cannot express the foreign key without both
//      sides, so the back-relation is declared. No new column: `walletId` is
//      the same field §3 specifies.
//   2. User.emailVerified, User.name, User.image and the accounts/sessions
//      back-relations — required by @auth/prisma-adapter. See section 3.
//   3. Account, Session, VerificationToken — required by @auth/prisma-adapter.
//   4. User referral + notification fields (marked "section 4" inline) — a
//      product addition requested after the handoff. Referral in particular has
//      fraud implications §7 cares about: it is the classic multi-account
//      vector, so the anti-abuse rules live in src/lib/referral.ts and were
//      written at the same time, not deferred.
//   5. AdminAction — the audit trail for operator writes. §6.1 routes FLAGGED
//      withdrawals to a person and §7 requires a stated reason for every
//      suspension; neither is answerable later without a record of who did it.
//   6. CountryInterest — who is waiting for tasks where. A member in a country
//      with no inventory currently hits a dead end, and §4.3's approval
//      problem needs exactly this evidence of demand.
//
// Known gap, deliberately left as §3 specifies: there is no index serving the
// job that flips Reward PENDING -> AVAILABLE (it filters on status and
// availableAt; the existing index is [userId, status]). Raise it with ALFA in
// Phase 1 rather than adding it here — §3 is the source of truth for this file.
//
// Phase 5 models (Distribution, SnapshotHolder, VaultLedger) are specified in
// HANDOFF.md §9 and MUST NOT be migrated until the legal gate clears.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// 1. People, wallets, devices
// ─────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  handle      String   @unique
  countryCode String   @db.Char(2)
  createdAt   DateTime @default(now())

  riskTier      RiskTier  @default(NEW)
  publicPayouts Boolean   @default(true) // shows handle on the proof table
  suspendedAt   DateTime?
  suspendReason String?

  wallets     Wallet[]
  rewards     Reward[]
  withdrawals Withdrawal[]
  disputes    Dispute[]
  devices     Device[]
  interests   CountryInterest[]

  // ── Referral (section 4) ──
  referralCode String    @unique
  referredById String?
  referredBy   User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]    @relation("Referrals")
  referredAt   DateTime?
  // Captured at signup so a self-referral can be refused. Real device
  // fingerprinting is §7 work and lands in Phase 1; this is the weaker check
  // that is available today.
  signupIpHash String?

  // ── Notification preferences (section 4) ──
  // These govern NOTIFICATIONS only. The sign-in code is transactional: it is
  // the account's only credential and is never suppressed by a preference.
  notifyRewards     Boolean @default(true)
  notifyWithdrawals Boolean @default(true)
  notifyDisputes    Boolean @default(true)
  unsubscribeToken  String  @unique

  // Auth.js additions — see section 3.
  emailVerified DateTime?
  name          String?
  image         String?
  accounts      Account[]
  sessions      Session[]

  @@index([countryCode])
  @@index([riskTier])
  @@index([referredById])
}

enum RiskTier {
  NEW // 72h withdrawal hold
  STANDARD // 24h hold
  TRUSTED // instant
  FLAGGED // manual review on every withdrawal
}

model Wallet {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  chain      Chain
  address    String
  verifiedAt DateTime?
  isPayout   Boolean   @default(false)

  withdrawals Withdrawal[]

  @@unique([chain, address]) // one wallet, one account — anti multi-account
  @@index([userId])
}

enum Chain {
  SOLANA
  BASE
}

model Device {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  fingerprint String
  ipHash      String
  vpnScore    Int?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([fingerprint])
  @@index([ipHash])
}

// ─────────────────────────────────────────────────────────────
// 2. Supply, rewards, money
// ─────────────────────────────────────────────────────────────

model Offer {
  id               String        @id @default(cuid())
  network          Network
  networkOfferId   String
  name             String
  description      String?
  category         OfferCategory
  countries        String[] // ISO-2, empty = all
  devices          String[] // ios | android | desktop
  advertiserPays   Decimal       @db.Decimal(10, 4) // NEVER expose via public API
  userPays         Decimal       @db.Decimal(10, 4) // what we show
  requiresPurchase Boolean       @default(false)
  purchaseAmount   Decimal?      @db.Decimal(10, 2)
  deadlineDays     Int?
  isActive         Boolean       @default(true)
  lastSeenAt       DateTime      @default(now())

  tiers OfferTier[]

  @@unique([network, networkOfferId])
  @@index([isActive, category])
}

enum Network {
  CPX
  LOOTABLY
  TIMEWALL
  TOROX
}

enum OfferCategory {
  SURVEY
  GAME
  APP
  SIGNUP
  MICROTASK
  SHOPPING
}

model OfferTier {
  id          String  @id @default(cuid())
  offerId     String
  offer       Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  sequence    Int
  label       String // "Board level 32"
  userPays    Decimal @db.Decimal(10, 4)
  completions Int     @default(0)
  starts      Int     @default(0)
  // completionRate is DERIVED: completions / starts. Never store a manual number.

  @@unique([offerId, sequence])
}

model Reward {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  offerId        String?
  network        Network
  networkTxnId   String // idempotency key
  tierLabel      String?
  amount         Decimal      @db.Decimal(10, 4)
  advertiserPaid Decimal      @db.Decimal(10, 4)
  status         RewardStatus @default(PENDING)
  availableAt    DateTime?
  reversedAt     DateTime?
  countryCode    String       @db.Char(2)
  rawPayload     Json

  createdAt DateTime @default(now())

  @@unique([network, networkTxnId]) // hard dedupe
  @@index([userId, status])
  @@index([createdAt])
}

enum RewardStatus {
  PENDING
  AVAILABLE
  REVERSED
  WITHHELD
}

model Withdrawal {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  walletId      String
  wallet        Wallet           @relation(fields: [walletId], references: [id])
  chain         Chain
  amount        Decimal          @db.Decimal(10, 4)
  status        WithdrawalStatus @default(REQUESTED)
  txHash        String?
  failureReason String?
  requestedAt   DateTime         @default(now())
  settledAt     DateTime?

  idempotencyKey String @unique

  @@index([userId])
  @@index([status])
  @@index([settledAt])
}

enum WithdrawalStatus {
  REQUESTED
  HELD
  APPROVED
  SENDING
  SETTLED
  FAILED
}

model Dispute {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  offerId       String?
  network       Network
  claimedAmount Decimal         @db.Decimal(10, 4)
  evidenceUrls  String[]
  status        DisputeStatus   @default(SUBMITTED)
  statusNote    String?
  firstReplyAt  DateTime?
  escalatedAt   DateTime?
  resolvedAt    DateTime?
  outcome       DisputeOutcome?
  createdAt     DateTime        @default(now())

  @@index([status])
  @@index([userId])
}

enum DisputeStatus {
  SUBMITTED
  ACKNOWLEDGED
  ESCALATED
  AWAITING_NETWORK
  RESOLVED
}

enum DisputeOutcome {
  PAID
  REJECTED_BY_ADVERTISER
  EXPIRED
  WITHDRAWN
}

model NetworkInvoice {
  id          String    @id @default(cuid())
  network     Network
  periodStart DateTime
  periodEnd   DateTime
  amountDue   Decimal   @db.Decimal(12, 2)
  amountPaid  Decimal?  @db.Decimal(12, 2)
  paidAt      DateTime?

  @@unique([network, periodStart])
}

// ─────────────────────────────────────────────────────────────
// 3. Auth.js — additive, required by @auth/prisma-adapter
//
// Not in HANDOFF.md §3 because §3 describes the product model, but the adapter
// cannot function without these. User gains only `emailVerified`, `name`, `image`
// and the two back-relations above; `name` and `image` exist for the optional
// Google provider and are never shown publicly — the proof table uses `handle`.
// ─────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

// Holds the hashed email OTP. Auth.js consumes the row on first use, which is
// what makes the code single-use.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// 4. Additions after the handoff — admin audit trail
// ─────────────────────────────────────────────────────────────

/**
 * Every state change an operator makes by hand.
 * §3 has no such model because §11 never names an admin panel — but §6.1 sends
 * FLAGGED withdrawals "to a person", and §7 requires a stated reason for every
 * suspension. Both of those are operator writes to a member's account, and an
 * operator write with no record of who made it is the thing disputes cannot be
 * resolved without.
 * `actorEmail` is a string rather than a relation on purpose: the admin
 * allowlist lives in the environment (see src/lib/admin/access.ts), so an
 * operator need not be a member, and the record must survive the account being
 * removed from the allowlist.
 */
model AdminAction {
  id         String   @id @default(cuid())
  actorEmail String
  action     String // e.g. "suspend", "set-tier", "approve-withdrawal"
  subjectId  String // the User, Withdrawal or Dispute acted on
  reason     String
  /**
   * Before/after, for the fields this action changed.
   */
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([subjectId, createdAt])
  @@index([createdAt])
}

/**
 * Who is waiting for tasks where.
 * A member whose country has no live inventory currently reaches a dead end:
 * the page says "nothing yet" and there is no way to tell them when that
 * changes, so the signup is wasted. This records the intent, and the payout
 * worker mails them when an offer for their country appears.
 * It is also the evidence §4.3's approval problem needs. Networks want proof of
 * traffic before they approve a publisher, and "412 people waiting in ID" is
 * exactly that — collected before there is anything to send them to.
 * countryCode is stored on the row rather than read from the User: someone who
 * moves country should still be told about the place they asked about.
 */
model CountryInterest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  countryCode String    @db.Char(2)
  createdAt   DateTime  @default(now())
  /**
   * Set when we have told them tasks went live. Null means still waiting.
   */
  notifiedAt  DateTime?

  @@unique([userId, countryCode]) // asking twice is the same ask
  @@index([countryCode, notifiedAt])
}
