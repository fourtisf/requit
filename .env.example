# ── core ────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://requit:requit@localhost:5432/requit?schema=public"
REDIS_URL="redis://localhost:6379"
# openssl rand -base64 32
AUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Canonical auth origin. REQUIRED in production: Auth.js runs with trustHost
# (needed behind Cloudflare and Nginx), and without this the Host header decides
# the sign-in origin. Leave empty locally.
AUTH_URL=""                  # production: https://requit.xyz

# Indexing is opt-in per deployment so staging cannot be indexed by omission.
# Production sets this to "true".
NEXT_PUBLIC_ALLOW_INDEXING=""

# Integration tests truncate every table in this database on every run.
# Never point it at one you care about.
TEST_DATABASE_URL="postgresql://requit:requit@localhost:5432/requit_test?schema=public"

# ── email (OTP delivery) ────────────────────────────────────────────────────
# Empty is allowed and the app still boots — the public site does not need mail.
# Sign-in does: with no server here, /signin says so instead of handing out a
# code that never arrives. In development the code is printed to the server log;
# in production it is NOT, because that log line is a credential.
EMAIL_SERVER=""
EMAIL_FROM="Requit <no-reply@requit.xyz>"

# ── offer networks — one set per network (Phase 1) ──────────────────────────
CPX_APP_ID=""
CPX_SECRET=""
CPX_POSTBACK_IPS=""          # comma-separated, from their dashboard
LOOTABLY_PLACEMENT_ID=""
LOOTABLY_API_KEY=""
LOOTABLY_POSTBACK_IPS=""
TIMEWALL_PUBLISHER_ID=""
TIMEWALL_SECRET=""
TIMEWALL_POSTBACK_IPS=""
TOROX_APP_ID=""
TOROX_SECRET=""
TOROX_POSTBACK_IPS=""

# ── chains (Phase 2) ───────────────────────────────────────────────────────
BASE_RPC_URL=""              # archive node required for Phase 5
SOLANA_RPC_URL=""
HOT_WALLET_KEYSTORE_PATH=""         # Base: encrypted keystore, NOT a raw key
HOT_WALLET_KEYSTORE_PATH_SOLANA=""  # Solana: same, separate file
HOT_WALLET_PASSPHRASE=""     # supplied at process start, not committed
USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"

# ── risk (Phase 1) ─────────────────────────────────────────────────────────
IPQS_API_KEY=""

# ── ops ────────────────────────────────────────────────────────────────────
# Who may open /admin. Comma-separated addresses, matched against the signed-in
# account. An EMPTY value means nobody — the panel can suspend accounts and
# release withdrawals, so "unconfigured" fails closed rather than open.
# Deliberately not a database column: a column is escalatable by any write path
# that can be tricked into updating a User row.
ADMIN_EMAILS=""

SENTRY_DSN=""
TELEGRAM_ALERT_BOT_TOKEN=""
TELEGRAM_ALERT_CHAT_ID=""
